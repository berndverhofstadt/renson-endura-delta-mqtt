# Renson Endura Delta local JSON API (no authentication, plain HTTP)
RENSON_HOST=192.168.1.60
RENSON_PORT=80
RENSON_TIMEOUT_SECONDS=8
POLL_INTERVAL_SECONDS=15

MQTT_HOST=192.168.1.50
MQTT_PORT=1883
# Defaults to true on ports 8883/8884/443, false otherwise. Set explicitly to override.
MQTT_TLS=false
MQTT_USERNAME=renson
MQTT_PASSWORD=
MQTT_BASE_TOPIC=home/ventilation/renson

# Home Assistant style auto-discovery. Off by default: the generated openHAB
# text config is the supported route (see tools/generate_openhab_config.py).
MQTT_DISCOVERY_ENABLED=false
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_DISCOVERY_DEVICE_ID=renson_endura_delta
MQTT_DISCOVERY_DEVICE_NAME=Renson Endura Delta

# Accept writes from MQTT at all. Set false for a read-only bridge.
CONTROLS_ENABLED=true
# Expose commissioning fields (flow offsets, I/O functions, preheater, region).
# The fields that latch fan tacho errors stay blocked even with this on.
EXPOSE_INSTALLER_SETTINGS=false

# Optional: mirror a fire-alarm topic and verify the unit actually stopped.
# The bridge never stops the fans itself - see docs/FIRE_SAFETY.md.
FIRE_ALARM_TOPIC=
FIRE_ALARM_PAYLOAD_ON=1,on,true,open,alarm,fire

# Container log timestamps, e.g. Europe/Brussels
TZ=UTC
LOG_LEVEL=INFO
HEALTHCHECK_PORT=8080
DEBUG_MODE=false
